<?xml version="1.0" ?>

<sdf version="1.9">
  <world name="smartcart_world">

    <!-- =========================
         PHYSICS
         ========================= -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- =========================
         GROUND
         ========================= -->
    <model name="ground_plane">
      <static>true</static>

      <link name="ground">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- =========================
         SUN / LIGHT
         ========================= -->
    <light
      name="sun"
      type="directional"
      cast_shadows="true">

      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.5 -1</direction>

    </light>


  </world>
</sdf>
