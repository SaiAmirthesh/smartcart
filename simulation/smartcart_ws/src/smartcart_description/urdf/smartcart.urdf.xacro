<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="smartcart">

  <!-- =========================
       MATERIALS
       ========================= -->

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>


  <!-- =========================
       BASE LINK
       ========================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.6 0.3"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.6 0.3"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="8.0"/>

      <inertia
        ixx="0.5"
        ixy="0.0"
        ixz="0.0"
        iyy="0.5"
        iyz="0.0"
        izz="0.5"/>
    </inertial>

  </link>


  <!-- =========================
       LEFT WHEEL
       ========================= -->

  <link name="left_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>

      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>
    </inertial>

  </link>


  <!-- =========================
       RIGHT WHEEL
       ========================= -->

  <link name="right_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>

      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>
    </inertial>

  </link>


  <!-- =========================
       LEFT WHEEL JOINT
       ========================= -->

  <joint name="left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.35 0.15"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- =========================
       RIGHT WHEEL JOINT
       ========================= -->

  <joint name="right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.35 0.15"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- =========================
       CASTER WHEEL
       ========================= -->

  <link name="caster_wheel">

    <visual>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>

      <inertia
        ixx="0.001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.001"
        iyz="0.0"
        izz="0.001"/>
    </inertial>

  </link>


  <!-- CASTER JOINT -->

  <joint name="caster_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="caster_wheel"/>

    <origin xyz="-0.3 0 0.08"/>

  </joint>


  <!-- =========================
       GAZEBO DIFFERENTIAL DRIVE
       ========================= -->

  <gazebo>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.7</wheel_separation>
      <wheel_radius>0.15</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/wheel/odometry</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <odom_publisher_frequency>30</odom_publisher_frequency>

      <tf_topic>/tf</tf_topic>

    </plugin>

  </gazebo>


  <!-- =========================
       LIDAR LINK
       ========================= -->

  <link name="lidar_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>

      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>

      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

  </link>


  <!-- =========================
       LIDAR FIXED JOINT
       ========================= -->

  <joint name="lidar_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0.25 0 0.38"
            rpy="0 0 0"/>

  </joint>


  <!-- =========================
       GAZEBO LIDAR SENSOR
       ========================= -->

  <gazebo reference="lidar_link">

    <sensor
      name="lidar"
      type="gpu_lidar">

      <!-- Gazebo Transport topic -->
      <topic>/scan</topic>

      <!-- Sensor frequency -->
      <update_rate>10</update_rate>

      <!-- Keep sensor active -->
      <always_on>true</always_on>

      <!-- Show rays in Gazebo -->
      <visualize>true</visualize>

      <!-- =========================
           RAY CONFIGURATION
           ========================= -->

      <ray>

        <scan>

          <horizontal>

            <samples>360</samples>

            <resolution>1</resolution>

            <min_angle>-3.14159</min_angle>

            <max_angle>3.14159</max_angle>

          </horizontal>

          <vertical>

            <samples>1</samples>

            <resolution>1</resolution>

            <min_angle>0</min_angle>

            <max_angle>0</max_angle>

          </vertical>

        </scan>


        <!-- =========================
             RANGE
             ========================= -->

        <range>

          <min>0.12</min>

          <max>10.0</max>

          <resolution>0.01</resolution>

        </range>

      </ray>

    </sensor>

  </gazebo>


</robot>
