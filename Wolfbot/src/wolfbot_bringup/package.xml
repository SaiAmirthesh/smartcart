<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wolfbot_bringup</name>
  <version>1.0.0</version>
  <description>Master launch files and hardware configuration for WolfBot physical platform</description>
  <maintainer email="sai@smartcart.local">SmartCart Hardware Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>wolfbot_description</exec_depend>
  <exec_depend>wolfbot_driver</exec_depend>
  <exec_depend>wolfbot_vision</exec_depend>
  <exec_depend>wolfbot_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
